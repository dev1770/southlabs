/* ------- GALLERY (infinite horizontal carousel) ------- */
section.gallery{
  position:relative;
  padding:clamp(70px,10vw,130px) 0 clamp(80px,11vw,150px);
  background:var(--bg-2);
  overflow:hidden;
}
section.gallery .section-head{ margin-bottom:56px; }
.gallery-head-cta{ display:flex;align-items:end;justify-content:flex-end; }

.marquee{
  display:flex;flex-direction:column;gap:clamp(14px,1.6vw,22px);
  /* let the rows bleed past the container edges, full-width band */
  width:100%;
  -webkit-mask-image:linear-gradient(to right,transparent,#000 7%,#000 93%,transparent);
  mask-image:linear-gradient(to right,transparent,#000 7%,#000 93%,transparent);
}
.marquee-row{
  display:flex;width:max-content;
  gap:clamp(14px,1.6vw,22px);
  will-change:transform;
}
.marquee-row.rowA{ animation:marqueeA 48s linear infinite; }
.marquee-row.rowB{ animation:marqueeB 60s linear infinite; }
/* pause on hover (desktop) or while a touch is held (.touch-paused via JS) */
.marquee:hover .marquee-row,
.marquee.touch-paused .marquee-row{ animation-play-state:paused; }
.marquee-row:focus-within{ animation-play-state:paused; }
@keyframes marqueeA{ from{transform:translate3d(0,0,0)} to{transform:translate3d(-50%,0,0)} }
@keyframes marqueeB{ from{transform:translate3d(-50%,0,0)} to{transform:translate3d(0,0,0)} }

.g-tile{
  position:relative;
  flex:0 0 auto;
  height:clamp(180px,26vw,300px);
  width:auto;
  aspect-ratio:var(--ratio,1);
  border-radius:5px;
  border:1px solid var(--border);
  background:var(--grad,var(--green-deep));
  cursor:pointer;
  padding:0;
  overflow:hidden;
  font-family:inherit;color:var(--cream);
  display:block;
  transition:transform .4s var(--ease), border-color .3s var(--ease), box-shadow .4s var(--ease);
}
.g-tile::after{
  content:"";position:absolute;inset:0;
  background:linear-gradient(to top,rgba(8,12,9,0.55),transparent 55%),
             radial-gradient(ellipse 80% 60% at 50% 25%,rgba(255,255,255,0.10),transparent 70%);
  transition:opacity .3s var(--ease);
}
.g-tile:hover,.g-tile:focus-visible{
  transform:translateY(-6px);
  border-color:var(--green-sage);
  box-shadow:0 18px 40px rgba(0,0,0,0.38);
}
.g-tile-meta{
  position:absolute;inset:auto 0 0 0;z-index:1;
  display:flex;align-items:baseline;justify-content:space-between;
  gap:10px;padding:14px 16px;
}
.g-tile-tag{ color:var(--cream); opacity:.92; }
.g-tile-idx{ color:var(--cream-faint); }
.g-tile-name{
  position:absolute;left:16px;right:16px;top:14px;z-index:1;
  font-family:'Instrument Serif',serif;font-style:italic;
  font-size:clamp(16px,1.5vw,21px);line-height:1.05;
  color:var(--cream);
  opacity:0;transform:translateY(-6px);
  transition:opacity .3s var(--ease),transform .3s var(--ease);
}
.g-tile:hover .g-tile-name,.g-tile:focus-visible .g-tile-name{ opacity:1;transform:none; }

@media (prefers-reduced-motion:reduce){
  .marquee{ overflow-x:auto;-webkit-overflow-scrolling:touch; }
  .marquee-row{ animation:none; }
  .g-tile:hover,.g-tile:focus-visible{ transform:none; }
}

/* ------- FAQ (shadcn-style accordion, native) ------- */
section.faq{ position:relative; padding:clamp(80px,12vw,150px) 0; }
