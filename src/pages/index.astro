/* ---------- proceso: pinned horizontal scroll ---------- */
(function initProceso(){
  if(!window.gsap || !window.ScrollTrigger) return;
  gsap.registerPlugin(ScrollTrigger);

  const section = document.getElementById("proceso");
  const pin = document.getElementById("procesoPin");
  const track = document.getElementById("procTrack");
  const chapters = gsap.utils.toArray(".chapter");
  const bar = document.getElementById("procBar");
  const curEl = document.getElementById("procCur");

  if(!section || !track || chapters.length === 0) return;

  // Make the section tall enough that scrolling through it pans through chapters.
  // We want: total scroll distance = (chapters.length - 1) * viewport height.
  // Pin height = 1 viewport, so section height = N * vh effectively.
  // We rely on ScrollTrigger's `end` function to set scroll distance.

  const totalShift = () => track.scrollWidth - window.innerWidth;

  gsap.to(track, {
    x: () => -totalShift(),
    ease: "none",
    scrollTrigger: {
      trigger: pin,
      start: "top top",
      end: () => "+=" + totalShift(),
      pin: true,
      scrub: 0.8,
      anticipatePin: 1,
      invalidateOnRefresh: true,
      onUpdate: (self) => {
        const p = self.progress;
        // counter (1..N)
        const idx = Math.min(chapters.length - 1, Math.floor(p * chapters.length * 0.999));
        const n = String(idx + 1).padStart(2, "0");
        if(curEl.textContent !== n) curEl.textContent = n;
        // progress bar
        bar.style.setProperty("--p", p.toFixed(4));

        // per-chapter fade based on distance to viewport center
        const vw = window.innerWidth;
        const center = vw * 0.5;
        chapters.forEach((ch) => {
          const r = ch.getBoundingClientRect();
          const chCenter = r.left + r.width / 2;
          const dist = Math.abs(chCenter - center) / vw;     // 0 at center, ~1 a screen away
          const opacity = Math.max(0, 1 - dist * 1.4);
          const ty = dist * 24;                              // subtle push down when off-center
          const sc = 1 - dist * 0.04;
          const content = ch.querySelector(".ch-content");
          const visual  = ch.querySelector(".ch-visual");
          const bgnum   = ch.querySelector(".ch-bg-num");
          if(content){
            content.style.opacity = opacity.toFixed(3);
            content.style.transform = `translate3d(0,${ty.toFixed(1)}px,0)`;
          }
          if(visual){
            visual.style.opacity = (0.4 + opacity * 0.6).toFixed(3);
            visual.style.transform = `translate3d(0,${(ty*-0.4).toFixed(1)}px,0) scale(${sc.toFixed(3)})`;
          }
          if(bgnum){
            // counter-parallax for the giant number
            const parallax = (chCenter - center) * 0.15;
            bgnum.style.transform = `translate3d(${parallax.toFixed(1)}px,0,0)`;
          }
        });
      }
    }
  });

  // recalc on font load (otherwise scrollWidth may be off)
  if(document.fonts && document.fonts.ready){
    document.fonts.ready.then(() => ScrollTrigger.refresh());
  }
})();

