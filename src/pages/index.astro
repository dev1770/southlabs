function startRain(){
  if(rainStarted || prefersReduced) return;
  if(!imagesReady || !introReleased) return;
  rainStarted = true;
  lastTs = performance.now();
  requestAnimationFrame(step);
}
window.startRain = startRain;   // let the intro signal us when the loader is done

lastTs = performance.now();
if(!prefersReduced){
  preloadImages(startRain);   // marks imagesReady, then tries to start
}
