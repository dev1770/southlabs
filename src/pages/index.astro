            <g transform="translate(0 -10) rotate(35)"><use href="#cannabis-leaf-5" transform="scale(0.32)"/></g>
            <g transform="translate(0 -50) rotate(-30)"><use href="#cannabis-leaf-5" transform="scale(0.26)"/></g>
            <g transform="translate(0 -50) rotate(30)"><use href="#cannabis-leaf-5" transform="scale(0.26)"/></g>
            <g transform="translate(0 -85)"><use href="#cannabis-leaf-5" transform="scale(0.20)"/></g>
