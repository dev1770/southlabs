    thc:"19%", cbd:"0.8%", flower:10, notes:["Limón","Hierba fresca","Dulce"], rot:14 },
  { idx:"06", tag:"Híbrida", name:"Sur <em>Diesel</em>",
    desc:"Combustible al primer aroma, especias y pino debajo. Cogollos compactos cubiertos de tricomas. Efecto profundo y duradero.",
    thc:"22%", cbd:"0.5%", flower:10, notes:["Diesel","Especias","Pino"], rot:-4 },
];

(function initVarietyExplorer(){
  const vsItems = [...document.querySelectorAll(".vs-item")];
  const featured = document.getElementById("varFeatured");
  const section = document.getElementById("variedades");
  if(vsItems.length === 0 || !featured) return;
  const els = {
    bgNum:   document.getElementById("vfBgNum"),
    tag:     document.getElementById("vfTag"),
    flower:  document.getElementById("vfFlower"),
    name:    document.getElementById("vfName"),
    desc:    document.getElementById("vfDesc"),
    notes:   document.getElementById("vfNotes"),
    thc:     document.getElementById("vfThc"),
    cbd:     document.getElementById("vfCbd"),
    flower2: document.getElementById("vfFlower2"),
    leaf:    document.getElementById("vfLeaf"),
  };

  let activeIdx = 0;
  let pending = null;

  function paint(i){
    const v = VARIETIES[i];
    els.bgNum.textContent  = v.idx;
    els.tag.textContent    = v.tag;
    els.flower.textContent = v.flower + " sem floración";
    els.name.innerHTML     = v.name;
    els.desc.textContent   = v.desc;
    els.notes.innerHTML    = v.notes.map(n => `<span>${n}</span>`).join("");
    els.thc.textContent    = v.thc;
    els.cbd.textContent    = v.cbd;
    els.flower2.textContent= v.flower;
    featured.style.setProperty("--leaf-rot", v.rot + "deg");
    els.leaf.style.transform = `rotate(${v.rot}deg)`;
  }

  function setActive(i, opts={}){
    if(i === activeIdx && !opts.force) return;
    activeIdx = i;
    vsItems.forEach((el, idx) => {
      const active = idx === i;
      el.classList.toggle("active", active);
      el.setAttribute("aria-selected", active ? "true" : "false");
    });
    if(opts.force){
      paint(i);
      return;
    }
    featured.classList.add("changing");
    if(pending) clearTimeout(pending);
    pending = setTimeout(() => {
      paint(i);
      featured.classList.remove("changing");
      pending = null;
    }, 220);
  }

  vsItems.forEach((el, idx) => {
    el.addEventListener("click", () => setActive(idx));
    el.addEventListener("keydown", (e) => {
      if(e.key === "Enter" || e.key === " "){ e.preventDefault(); setActive(idx); }
    });
  });

  // arrow-key navigation while section is on screen
  let inView = false;
  const io = new IntersectionObserver((ents) => {
    ents.forEach(e => { inView = e.isIntersecting; });
  }, { threshold: 0.25 });
  io.observe(section);

  document.addEventListener("keydown", (e) => {
    if(!inView) return;
    const tag = (document.activeElement || {}).tagName || "";
    if(tag === "INPUT" || tag === "TEXTAREA") return;
    if(e.key === "ArrowDown" || e.key === "ArrowRight"){
      e.preventDefault();
      setActive((activeIdx + 1) % VARIETIES.length);
    } else if(e.key === "ArrowUp" || e.key === "ArrowLeft"){
      e.preventDefault();
      setActive((activeIdx - 1 + VARIETIES.length) % VARIETIES.length);
    }
  });

  setActive(0, { force:true });
})();

/* ---------- nav drawer ---------- */
const menuBtn = document.getElementById("menuBtn");
const drawer = document.getElementById("drawer");
const drawerScrim = document.getElementById("drawerScrim");
function setMenu(open){
