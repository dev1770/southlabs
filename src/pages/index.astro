let ticking2 = false, lastY = -1;
function updateContent(){
  ticking2 = false;
  const y = window.scrollY;
  if(y === lastY) return; lastY = y;
  const progress = Math.max(0, Math.min(1.25, y / heroH));
  const contentTy = progress * heroH * 0.18;
  const contentOp = Math.max(0, 1 - progress * 1.25);
  heroContent.style.transform = `translate3d(0,${contentTy.toFixed(1)}px,0)`;
  heroContent.style.opacity = contentOp.toFixed(3);
}
window.addEventListener("scroll", () => {
  if(!ticking2){ requestAnimationFrame(updateContent); ticking2 = true; }
}, { passive:true });
}

/* ---------- intro: random-sticker loader → split curtain ---------- */
(function initIntro(){
  const intro = document.getElementById("intro");
  const img = document.getElementById("introImg");
  if(!intro){ document.body.classList.remove("intro-active"); window.dispatchEvent(new Event("sl:intro-open")); return; }
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const CURTAIN = 760;    // panel split transition

  // avisa al hero que la cortina abre → ahí arranca el "flicker-on" de la planta
  const signalOpen = () => window.dispatchEvent(new Event("sl:intro-open"));

  function finish(){
    intro.classList.add("split");
    signalOpen();
    // tear down the overlay once the curtain finished
    setTimeout(() => {
      intro.classList.add("done");
      document.body.classList.remove("intro-active");
    }, CURTAIN);
  }

  if(reduce){ intro.classList.add("done"); document.body.classList.remove("intro-active"); signalOpen(); return; }

  // show a random sticker as the loader, then split open to reveal the 3D hero
  img.src = IMG_SRCS[(Math.random()*IMG_SRCS.length)|0];
  setTimeout(finish, 1300);
})();

/* ---------- gallery marquee: pause on touch so tapping a tile works ---------- */
(function initMarquee(){
  const m = document.getElementById("marquee");
  if(!m) return;
  let resume = null;
  m.addEventListener("touchstart", () => {
    m.classList.add("touch-paused");
    if(resume) clearTimeout(resume);
  }, { passive:true });
  m.addEventListener("touchend", () => {
    if(resume) clearTimeout(resume);
    resume = setTimeout(() => m.classList.remove("touch-paused"), 2600);
  }, { passive:true });
})();

/* ---------- FAQ accordion (single-open, shadcn-style) ---------- */
(function initFaq(){
  const list = document.getElementById("faqList");
  if(!list) return;
  const items = [...list.querySelectorAll(".faq-item")];
  items.forEach((item) => {
    const btn = item.querySelector(".faq-q");
    btn.addEventListener("click", () => {
      const willOpen = !item.classList.contains("open");
      items.forEach((other) => {
        const open = other === item && willOpen;
        other.classList.toggle("open", open);
        other.querySelector(".faq-q").setAttribute("aria-expanded", open ? "true" : "false");
      });
    });
  });
})();

/* ---------- form: ayuda condicional según respuestas ---------- */
(function initFormLogic(){
  const form = document.getElementById("contactForm");
  if(!form) return;
  function bind(selectId, helpId, predicate){
    const sel = document.getElementById(selectId);
    const help = document.getElementById(helpId);
    if(!sel || !help) return;
    const update = () => help.classList.toggle("show", predicate(sel.value));
    sel.addEventListener("change", update);
    update();
  }
  // delegando hoy a ONG o tercero → no podés estar vinculado en dos lados
  bind("cf-delegando", "help-delegando", v => v === "ong" || v === "tercero");
  // médico no habilitado o sin médico → diplomatura / te recomendamos uno
  bind("cf-medico", "help-medico", v => v === "no-se" || v === "no");
  // fuera de AMBA → te avisamos cuando lleguemos
  bind("cf-zona", "help-zona", v => v === "otra");
})();

/* ---------- contact form (no backend yet: client-side success) ---------- */
(function initContactForm(){
  const form = document.getElementById("contactForm");
  const success = document.getElementById("formSuccess");
  if(!form || !success) return;
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    if(!form.reportValidity()) return;   // native required/email validation
    // TODO: wire to a real endpoint (Formspree / API / email service)
    form.classList.add("sent");
    success.classList.add("show");
    success.scrollIntoView({ behavior:"smooth", block:"center" });
    form.reset();
  });
})();
