  menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
  drawer.setAttribute("aria-hidden", open ? "false" : "true");
}
menuBtn.addEventListener("click", () => setMenu(!document.body.classList.contains("menu-open")));
drawerScrim.addEventListener("click", () => setMenu(false));
drawer.querySelectorAll("a").forEach(a => a.addEventListener("click", () => setMenu(false)));
document.addEventListener("keydown", e => { if(e.key === "Escape") setMenu(false); });

/* ---------- nav scroll state ---------- */
const nav = document.getElementById("nav");
function onScrollNav(){
  if(window.scrollY > 8) nav.classList.add("scrolled");
  else nav.classList.remove("scrolled");
}
onScrollNav();
window.addEventListener("scroll", onScrollNav, { passive:true });

/* sticker assets — los sigue usando el loader del intro (más abajo) */
const IMG_SRCS = [
  "/assets/hero/bud-1.png","/assets/hero/bud-2.png","/assets/hero/bud-3.png",
  "/assets/hero/bud-4.png","/assets/hero/bud-5.png","/assets/hero/bud-6.png",
  "/assets/hero/kit-1.png","/assets/hero/kit-2.png","/assets/hero/kit-3.png",
  "/assets/hero/kit-4.png","/assets/hero/kit-5.png","/assets/hero/kit-6.png"
];

/* ---------- chaotic rain canvas (Matter.js) — DEPRECADO ----------
   Reemplazado por el hero 3D que se parte (HeroSplit.astro).
   Se conserva el código tal cual pero deshabilitado (`if(false)`).        */
if (false) {
const canvas = document.getElementById("rainCanvas");
const ctx = canvas.getContext("2d");
const heroEl = document.getElementById("hero");
const heroContent = document.getElementById("heroContent");
const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

const M = window.Matter;
let engine, world;
let floor, leftWall, rightWall;
let rects = [];
let W = 0, H = 0, dpr = 1;
let phase = "FILL";        // FILL | SETTLING | IDLE_FULL | EMPTY | IDLE_EMPTY
let phaseStart = 0;
let lastSpawn = 0;
let maxCount = 50;
const FILL_FRAC = 0.5;     // stickers fill only the bottom ~50% of the hero
let introReleased = false; // set true when the intro loader finishes
let rainStarted = false;
let lastTs = performance.now();

/* hero sticker assets (sliced from the transparent sheet) */
const IMG_SRCS = [
  "/assets/hero/bud-1.png","/assets/hero/bud-2.png","/assets/hero/bud-3.png",
  "/assets/hero/bud-4.png","/assets/hero/bud-5.png","/assets/hero/bud-6.png",
  "/assets/hero/kit-1.png","/assets/hero/kit-2.png","/assets/hero/kit-3.png",
  "/assets/hero/kit-4.png","/assets/hero/kit-5.png","/assets/hero/kit-6.png"
];
const images = [];
let imagesReady = false;
function preloadImages(done){
  let n = 0;
  IMG_SRCS.forEach(src => {
    const im = new Image();
    im.onload = im.onerror = () => { if(++n === IMG_SRCS.length){ imagesReady = true; done && done(); } };
    im.src = src;
    images.push(im);
  });
}

function sizeCanvas(){
  dpr = Math.min(window.devicePixelRatio || 1, 2);
  const rect = heroEl.getBoundingClientRect();
  W = rect.width;
  H = rect.height;
  canvas.width  = Math.round(W * dpr);
  canvas.height = Math.round(H * dpr);
  canvas.style.width = W + "px";
  canvas.style.height = H + "px";
  ctx.setTransform(dpr,0,0,dpr,0,0);
  buildWorld();
}

function buildWorld(){
  if(engine) { M.World.clear(world, false); M.Engine.clear(engine); }
  engine = M.Engine.create();
  world = engine.world;
  engine.gravity.y = 1.4;
  engine.positionIterations = 10;
  engine.velocityIterations = 10;

  const wallOpt = { isStatic:true, friction:0.5, restitution:0.05 };
  // make walls thick & extra-tall so nothing tunnels through
  floor      = M.Bodies.rectangle(W/2, H + 100, W*3, 200, wallOpt);
  leftWall   = M.Bodies.rectangle(-100, H/2, 200, H*4, wallOpt);
  rightWall  = M.Bodies.rectangle(W+100, H/2, 200, H*4, wallOpt);
  M.World.add(world, [floor, leftWall, rightWall]);
  rects = [];

  // target density: cover ~70% of the bottom FILL_FRAC of the hero
  const avgArea = 110 * 110;
  maxCount = Math.max(14, Math.round((W * H * FILL_FRAC * 0.72) / avgArea));

  phase = "FILL";
  phaseStart = performance.now();
  lastSpawn = 0;
}

function spawnRect(){
  // pick a sticker; physics body is its bounding box, size keeps the real aspect ratio
  const img = images[(Math.random()*images.length)|0];
  const ar  = (img && img.naturalWidth / img.naturalHeight) || 0.78;   // portrait buds
  const minSide = Math.max(70, Math.min(W,H) * 0.08);
  const maxSide = Math.max(130, Math.min(W,H) * 0.20);
  const w = minSide + Math.random() * (maxSide - minSide);
  const h = w / ar;

  const x = w/2 + Math.random() * (W - w);
  const y = -h - Math.random() * h * 1.2;

  // collision body ~20% smaller than the drawn sticker so they visually overlap
  const HITBOX = 0.8;
  const body = M.Bodies.rectangle(x, y, w * HITBOX, h * HITBOX, {
    restitution: 0.35 + Math.random()*0.15,
    friction: 0.28,
    frictionAir: 0.005,
    density: 0.0014,
    angle: (Math.random()-0.5) * 0.9
  });
  // initial nudges so they don't all fall straight
  M.Body.setVelocity(body, { x:(Math.random()-0.5)*1.6, y:0 });
  M.Body.setAngularVelocity(body, (Math.random()-0.5) * 0.1);

  body.gfx = { w, h, img };
  M.World.add(world, body);
  rects.push(body);
}

function drawSticker(img, w, h){
  if(!img) return;
  ctx.drawImage(img, -w/2, -h/2, w, h);
}

const SPAWN_INTERVAL = 220;
const IDLE_FULL_MS = 4500;
const IDLE_EMPTY_MS = 900;
const SETTLE_VEL = 0.6;

function settledTop(){
  // topmost y of rects that are inside the hero AND nearly at rest
  let top = H;
  for(const r of rects){
    if(r.position.y < 0) continue;                // still above the viewport
    const sp = Math.hypot(r.velocity.x, r.velocity.y);
    if(sp > 2.5) continue;                         // still moving fast
    const t = r.position.y - r.gfx.h/2;
    if(t < top) top = t;
  }
  return top;
}
function settledCount(){
  let n = 0;
  for(const r of rects){
    if(r.position.y < 0) continue;
    if(Math.hypot(r.velocity.x, r.velocity.y) > 2.5) continue;
    n++;
  }
  return n;
}
function avgSpeed(){
  if(rects.length === 0) return 0;
  let s = 0;
  for(const r of rects) s += Math.hypot(r.velocity.x, r.velocity.y);
  return s / rects.length;
}
function allOffscreen(){
  for(const r of rects){
    if(r.position.y - r.gfx.h < H + 40) return false;
  }
  return true;
}

function step(now){
  const dt = 1000/60;  // fixed step for stable physics
  lastTs = now;

  // physics
  M.Engine.update(engine, dt);

  // phase logic
  if(phase === "FILL"){
    if(now - lastSpawn > SPAWN_INTERVAL + Math.random()*180 && rects.length < maxCount){
      spawnRect();
      if(Math.random() < 0.12 && rects.length < maxCount) spawnRect();
      lastSpawn = now;
    }
    // Only stop filling once enough rects are SETTLED in the hero,
    // not when a brand-new spawn is still in the air above y=0.
    const top = settledTop();
    const fillLine = H * (1 - FILL_FRAC);   // pile shouldn't rise above the 50% line
    const stopByHeight = top < fillLine && settledCount() >= maxCount * 0.6;
    const stopByCount  = rects.length >= maxCount && settledCount() >= maxCount * 0.85;
    if(stopByHeight || stopByCount){
      phase = "SETTLING";
      phaseStart = now;
    }
  }
  else if(phase === "SETTLING"){
    // wait for the pile to relax, then go idle
    if(now - phaseStart > 2500 || avgSpeed() < SETTLE_VEL){
      phase = "IDLE_FULL";
      phaseStart = now;
    }
  }
  else if(phase === "IDLE_FULL"){
    if(now - phaseStart > IDLE_FULL_MS){
      phase = "EMPTY";
      phaseStart = now;
      // drop the floor + walls so they all fall through
      M.World.remove(world, floor);
      M.World.remove(world, leftWall);
      M.World.remove(world, rightWall);
      // give each a tiny extra impulse for character
      for(const r of rects){
        M.Body.setVelocity(r, { x: r.velocity.x + (Math.random()-0.5)*1.2, y: 1 + Math.random()*2 });
        M.Body.setAngularVelocity(r, r.angularVelocity + (Math.random()-0.5)*0.06);
      }
    }
  }
  else if(phase === "EMPTY"){
    if(allOffscreen() || now - phaseStart > 4500){
      phase = "IDLE_EMPTY";
      phaseStart = now;
      // clean slate
      M.World.clear(world, false);
      M.Engine.clear(engine);
      rects = [];
    }
  }
  else if(phase === "IDLE_EMPTY"){
    if(now - phaseStart > IDLE_EMPTY_MS){
      buildWorld();
    }
  }

  // render
  ctx.clearRect(0, 0, W, H);
  for(const b of rects){
    ctx.save();
    ctx.translate(b.position.x, b.position.y);
    ctx.rotate(b.angle);
    drawSticker(b.gfx.img, b.gfx.w, b.gfx.h);
    ctx.restore();
  }

  requestAnimationFrame(step);
}

sizeCanvas();
let resizeTimer = null;
window.addEventListener("resize", () => {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(sizeCanvas, 150);
});
